        "body": {
          "mode": "raw",
          "raw": "{\n  \"cardId\": \"{{uniqueIdentifier}}\",\n  \"winType\": \"line\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/games/{{gameId}}/validate",
          "host": ["{{baseUrl}}"],
          "path": ["games", "{{gameId}}", "validate"]
        }
      }
