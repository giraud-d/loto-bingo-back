    {
      "name": "11. Validate Card (Line)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Validation result returned', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('isValid');",
              "    pm.expect(jsonData).to.have.property('cardId');",
              "    pm.expect(jsonData).to.have.property('winType');",
              "});",
              "",
              "pm.test('Card id matches', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.cardId).to.equal(pm.environment.get('uniqueIdentifier'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
