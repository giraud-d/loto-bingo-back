            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Draw count is 15', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.drawCount).to.equal(15);",
              "});",
              "",
              "pm.test('Probability by draw has 15 entries', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.probabilityByDraw.length).to.equal(15);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
