        }
      }
    },
    {
      "name": "8. Get Game Status (After Draws)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Game status is in_progress', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.equal('in_progress');",
              "});",
              "",
              "pm.test('Has drawn numbers', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.drawnCount).to.be.at.least(3);",
              "});",
              "",
              "pm.test('Remaining numbers decreased', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.remainingNumbers.length).to.be.below(20);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/games/{{gameId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["games", "{{gameId}}", "status"]
        }
      }
    },
    {
      "name": "9. Get Statistics (Current)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Has statistics data', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('totalCards');",
              "    pm.expect(jsonData).to.have.property('drawCount');",
              "    pm.expect(jsonData).to.have.property('probabilityFirstWin');",
              "    pm.expect(jsonData).to.have.property('expectedWinners');",
              "});",
              "",
              "pm.test('Total cards is 5', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.totalCards).to.equal(5);",
              "});",
              "",
              "pm.test('Has probability by draw', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.probabilityByDraw).to.be.an('array');",
              "    pm.expect(jsonData.probabilityByDraw.length).to.be.at.least(1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/games/{{gameId}}/statistics",
          "host": ["{{baseUrl}}"],
          "path": ["games", "{{gameId}}", "statistics"]
        }
      }
    },
